# Top-most EditorConfig file — applies to the whole repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{ts,tsx,js,mjs,cjs,json,css,html,yml,yaml}]
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
