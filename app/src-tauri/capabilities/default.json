{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core access plus window controls (drag, zoom/minimize) for the main window. Without core:window:allow-start-dragging the custom title-bar can't move the window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-focus",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-badge-label"
  ]
}
